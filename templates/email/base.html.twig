<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{{ subject|default('Место') }}</title>
</head>
<body style="margin:0; padding:0; background-color:#f6f6f4; color:#262827; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" bgcolor="#f6f6f4" style="width:100%; border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;">
        <tr>
            <td align="center" style="padding:32px 16px;">
                <!--[if mso]>
                <table width="560" cellpadding="0" cellspacing="0" border="0" role="presentation"><tr><td>
                <![endif]-->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="width:100%; max-width:560px; border-collapse:separate; border-spacing:0; mso-table-lspace:0pt; mso-table-rspace:0pt;">
                    <tr>
                        <td style="padding:0 0 24px 8px; font-family:Arial, Helvetica, sans-serif; font-size:30px; line-height:36px; font-weight:bold; letter-spacing:-1.6px; color:#262827;">
                            место
                        </td>
                    </tr>
                    <tr>
                        <td bgcolor="#ffffff" style="padding:32px 24px; background-color:#ffffff; border:1px solid #e2e3df; border-radius:16px; font-family:Arial, Helvetica, sans-serif; color:#262827;">
                            {% block body %}{% endblock %}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:24px 8px 0; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#858783;">
                            © {{ 'now'|date('Y', 'Europe/Moscow') }} Место<br>
                            Письмо создано автоматически, пожалуйста, не отвечайте на него.
                        </td>
                    </tr>
                </table>
                <!--[if mso]>
                </td></tr></table>
                <![endif]-->
            </td>
        </tr>
    </table>
</body>
</html>
